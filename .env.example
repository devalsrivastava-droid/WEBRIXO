# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Optional: send sign-in codes from your own address via Resend (set in the Convex dashboard)
RESEND_API_KEY=
AUTH_EMAIL_FROM=WEBRIXO <hello@webrixo.com>

# Testing only: print sign-in codes to the Convex logs instead of emailing them.
# Never set this on a live deployment.
# AUTH_DEV_LOG_CODES=true

# ── Payments ────────────────────────────────────────────────────────────────
# Set these in the Convex dashboard (Settings → Environment variables), NOT here.
# Nothing below belongs in the repo or in the browser bundle.
#
# Stripe — used for every currency except INR
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...        from the endpoint you create at
#                                        https://<deployment>.convex.site/webhooks/stripe
#
# Razorpay — used for INR so rupees settle directly to an Indian account
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...            from the webhook you create at
#                                        https://<deployment>.convex.site/webhooks/razorpay
#
# Where the customer comes back to after paying
# SITE_URL=https://webrixo.com
